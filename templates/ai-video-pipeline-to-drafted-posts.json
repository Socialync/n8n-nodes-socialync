    {
      "parameters": {
        "jsCode": "const ALLOWED = [\"facebook\",\"instagram\",\"linkedin\",\"twitter\",\"threads\",\"bluesky\",\"tiktok\",\"youtube\"];\nfunction parsePlatforms(raw) {\n  const list = (Array.isArray(raw) ? raw : String(raw || '').split(','))\n    .map((p) => String(p).trim().toLowerCase())\n    .filter(Boolean)\n    .map((p) => (p === 'x' ? 'twitter' : p));\n  const unknown = list.filter((p) => !ALLOWED.includes(p));\n  if (unknown.length) throw new Error('Socialync cannot post to: ' + unknown.join(', ') + '. Use: ' + ALLOWED.join(', ') + '.');\n  if (!list.length) throw new Error('Set at least one platform in the Settings node.');\n  return [...new Set(list)];\n}\nconst s = $('Settings').first().json;\nconst raw = String($input.first().json.text || '');\nconst found = raw.match(/\\{[\\s\\S]*\\}/);\nif (!found) throw new Error('The AI model did not answer with JSON. Run the workflow again.');\nlet idea;\ntry { idea = JSON.parse(found[0]); } catch (e) { throw new Error('The AI answer was not valid JSON. Run the workflow again.'); }\nconst videoPrompt = String(idea.videoPrompt || '').trim();\nconst caption = String(idea.caption || '').trim();\nconst title = String(idea.title || '').trim();\nif (!videoPrompt || !caption) throw new Error('The AI answer had no video prompt or no caption.');\nconst platforms = parsePlatforms(s.platforms);\nif (platforms.includes('youtube') && !title) throw new Error('YouTube needs a title.');\nconst level = String(s.tiktokPrivacyLevel || '').trim();\nconst LEVELS = ['PUBLIC_TO_EVERYONE', 'MUTUAL_FOLLOW_FRIENDS', 'FOLLOWER_OF_CREATOR', 'SELF_ONLY'];\nif (platforms.includes('tiktok') && !LEVELS.includes(level)) {\n  throw new Error('TikTok needs a privacy level that you choose. Set tiktokPrivacyLevel in Settings to one of: ' + LEVELS.join(', ') + '.');\n}\nreturn [{ json: { videoPrompt, caption, title, platforms, tiktokPrivacyLevel: level } }];"
      },
