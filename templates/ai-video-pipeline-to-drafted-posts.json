    {
      "parameters": {
        "jsCode": "// Socialync accepts 1 to 255 letters, digits and _ . : - in an Idempotency Key.\nfunction safeKey(prefix, value) {\n  return (prefix + ':' + String(value)).replace(/[^A-Za-z0-9_.:-]/g, '-').slice(0, 200);\n}\nconst s = $('Settings').first().json;\nconst idea = $('Read the AI answer').first().json;\nconst videoUrl = String($input.first().json.videoUrl || '').trim();\nif (!/^https:\\/\\//i.test(videoUrl)) throw new Error('The video link must be a public https link. Check the Map the render result node.');\nconst delay = Math.max(5, Number(s.publishDelayMinutes) || 720);\nconst jobId = String($('Map the render reply').first().json.jobId || '').trim();\nif (!jobId) throw new Error('The render reply has no job ID. Edit the Map the render reply node so it returns jobId.');\nreturn [{ json: {\n  profileId: String(s.profileId || '').trim(),\n  platforms: idea.platforms,\n  caption: idea.caption,\n  title: idea.title,\n  tiktokPrivacyLevel: idea.tiktokPrivacyLevel,\n  videoUrl,\n  scheduledAt: new Date(Date.now() + delay * 60000).toISOString(),\n  idempotencyKey: safeKey('video', jobId),\n} }];"
      },
