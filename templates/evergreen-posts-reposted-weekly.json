    {
      "parameters": {
        "jsCode": "const ALLOWED = [\"facebook\",\"instagram\",\"linkedin\",\"twitter\",\"threads\",\"bluesky\",\"tiktok\",\"youtube\"];\nfunction parsePlatforms(raw) {\n  const list = (Array.isArray(raw) ? raw : String(raw || '').split(','))\n    .map((p) => String(p).trim().toLowerCase())\n    .filter(Boolean)\n    .map((p) => (p === 'x' ? 'twitter' : p));\n  const unknown = list.filter((p) => !ALLOWED.includes(p));\n  if (unknown.length) throw new Error('Socialync cannot post to: ' + unknown.join(', ') + '. Use: ' + ALLOWED.join(', ') + '.');\n  if (!list.length) throw new Error('Set at least one platform in the Settings node.');\n  return [...new Set(list)];\n}\n// Socialync accepts 1 to 255 letters, digits and _ . : - in an Idempotency Key.\nfunction safeKey(prefix, value) {\n  return (prefix + ':' + String(value)).replace(/[^A-Za-z0-9_.:-]/g, '-').slice(0, 200);\n}\nconst s = $('Settings').first().json;\nconst row = $input.first().json;\nconst problem = (message) => [{ json: { ok: false, problem: message } }];\ntry {\n  const caption = String(row.Caption || '').trim();\n  if (!caption) return problem('The Caption of this record is empty.');\n  const platforms = parsePlatforms(String(row.Platforms || '').trim() || s.defaultPlatforms);\n  const imageUrl = String(row['Image URL'] || '').trim();\n  if (imageUrl && !/^https:\\/\\//i.test(imageUrl)) return problem('Image URL needs a public https link.');\n  if (platforms.includes('instagram') && !imageUrl) return problem('Instagram needs an Image URL.');\n  if (platforms.some((p) => p === 'tiktok' || p === 'youtube')) return problem('This template posts text and images. Remove tiktok and youtube from Platforms.');\n  const now = new Date();\n  const start = Date.UTC(now.getUTCFullYear(), 0, 1);\n  const week = Math.floor((now.getTime() - start) / (7 * 86400000)) + 1;\n  const delay = Math.max(5, Number(s.publishDelayMinutes) || 60);\n  return [{ json: {\n    ok: true,\n    post: {\n      profileId: String(s.profileId || '').trim(),\n      platforms,\n      caption,\n      scheduledAt: new Date(Date.now() + delay * 60000).toISOString(),\n      mediaSource: imageUrl ? 'imageUrls' : 'none',\n      imageUrls: imageUrl,\n      idempotencyKey: safeKey('evergreen', row.id + ':' + now.getUTCFullYear() + 'w' + week),\n    },\n    timesPosted: (Number(row['Times Posted']) || 0) + 1,\n    postedOn: now.toISOString().slice(0, 10),\n  } }];\n} catch (e) {\n  return problem(e.message);\n}"
      },
