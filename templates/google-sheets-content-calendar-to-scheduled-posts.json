    {
      "parameters": {
        "jsCode": "const ALLOWED = [\"facebook\",\"instagram\",\"linkedin\",\"twitter\",\"threads\",\"bluesky\",\"tiktok\",\"youtube\"];\nfunction parsePlatforms(raw) {\n  const list = (Array.isArray(raw) ? raw : String(raw || '').split(','))\n    .map((p) => String(p).trim().toLowerCase())\n    .filter(Boolean)\n    .map((p) => (p === 'x' ? 'twitter' : p));\n  const unknown = list.filter((p) => !ALLOWED.includes(p));\n  if (unknown.length) throw new Error('Socialync cannot post to: ' + unknown.join(', ') + '. Use: ' + ALLOWED.join(', ') + '.');\n  if (!list.length) throw new Error('Set at least one platform in the Settings node.');\n  return [...new Set(list)];\n}\n// '2026-11-12 09:30' is read in the Settings time zone. A value with Z or an offset is used as written.\nfunction parseWhen(text, zone) {\n  const s = String(text || '').trim();\n  if (!s) return null;\n  if (/([zZ]|[+-]\\d{2}:?\\d{2})$/.test(s)) {\n    const d = new Date(s);\n    return isNaN(d.getTime()) ? null : d;\n  }\n  const m = s.match(/^(\\d{4})-(\\d{2})-(\\d{2})(?:[ T](\\d{1,2}):(\\d{2}))?/);\n  if (!m) return null;\n  const [y, mo, d] = m.slice(1, 4).map(Number);\n  const h = m[4] === undefined ? 9 : Number(m[4]);\n  const mi = m[5] === undefined ? 0 : Number(m[5]);\n  const guess = Date.UTC(y, mo - 1, d, h, mi);\n  const offsetAt = (t) => {\n    const parts = new Intl.DateTimeFormat('en-US', {\n      timeZone: zone, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit',\n    }).formatToParts(new Date(t));\n    const v = {};\n    for (const p of parts) if (p.type !== 'literal') v[p.type] = Number(p.value);\n    return Date.UTC(v.year, v.month - 1, v.day, v.hour, v.minute, v.second) - t;\n  };\n  let utc = guess - offsetAt(guess);\n  utc = guess - offsetAt(utc);\n  return new Date(utc);\n}\n// A short hash of the content, so the key stays the same on every run for the same row.\nfunction shortHash(text) {\n  let h = 5381;\n  for (let i = 0; i < text.length; i++) h = ((h * 33) ^ text.charCodeAt(i)) >>> 0;\n  return h.toString(36);\n}\n// Socialync accepts 1 to 255 letters, digits and _ . : - in an Idempotency Key.\nfunction safeKey(prefix, value) {\n  return (prefix + ':' + String(value)).replace(/[^A-Za-z0-9_.:-]/g, '-').slice(0, 200);\n}\nconst row = $('Get the next Ready row').first().json;\nconst s = $input.first().json;\nconst problem = (message) => [{ json: { ok: false, problem: message } }];\n\ntry {\n  const caption = String(row.Caption || '').trim();\n  if (!caption) return problem('Caption is empty.');\n  const platforms = parsePlatforms(String(row.Platforms || '').trim() || s.defaultPlatforms);\n  const imageUrl = String(row['Image URL'] || '').trim();\n  const videoUrl = String(row['Video URL'] || '').trim();\n  if (imageUrl && videoUrl) return problem('Fill in only one of Image URL and Video URL.');\n  for (const link of [imageUrl, videoUrl]) {\n    if (link && !/^https:\\/\\//i.test(link)) return problem('Image URL and Video URL need public https links.');\n  }\n  if (platforms.includes('instagram') && !imageUrl && !videoUrl) return problem('Instagram needs an Image URL or a Video URL.');\n  const title = String(row.Title || '').trim();\n  if (platforms.includes('youtube') && !title) return problem('YouTube needs a Title.');\n  const level = String(s.tiktokPrivacyLevel || '').trim();\n  if (platforms.includes('tiktok') && !level) return problem('TikTok needs a privacy level. Set tiktokPrivacyLevel in Settings.');\n\n  const earliest = Date.now() + Math.max(5, Number(s.publishDelayMinutes) || 60) * 60000;\n  let when = null;\n  const rawWhen = String(row['Publish at'] || '').trim();\n  if (rawWhen) {\n    try { when = parseWhen(rawWhen, s.timezone || 'UTC'); } catch (e) { return problem('The time zone \"' + s.timezone + '\" in Settings is not valid. Use a name like America/New_York.'); }\n    if (!when) return problem('Publish at must look like 2026-11-12 09:30.');\n  }\n  const scheduledAt = new Date(Math.max(earliest, when ? when.getTime() : 0)).toISOString();\n\n  return [{ json: {\n    ok: true,\n    post: {\n      profileId: String(s.profileId || '').trim(),\n      platforms,\n      caption,\n      scheduledAt,\n      mediaSource: videoUrl ? 'videoUrl' : imageUrl ? 'imageUrls' : 'none',\n      imageUrls: imageUrl,\n      videoUrl,\n      title,\n      tiktokPrivacyLevel: level,\n      idempotencyKey: safeKey('sheet', row.row_number + ':' + shortHash(rawWhen + '|' + platforms.join(',') + '|' + caption)),\n    },\n  } }];\n} catch (e) {\n  return problem(e.message);\n}"
      },
