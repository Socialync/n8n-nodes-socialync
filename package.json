{
	"name": "n8n-nodes-socialync",
	"version": "0.1.0",
	"description": "n8n node for the Socialync API: publish and schedule posts to eight social platforms, upload media and read analytics.",
	"license": "MIT",
	"homepage": "https://www.socialync.io/developers/api",
	"keywords": [
		"n8n-community-node-package",
		"socialync",
		"social media",
		"scheduling"
	],
	"author": {
		"name": "Socialync",
		"email": "support@socialync.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Socialync/n8n-nodes-socialync.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SocialyncApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Socialync/Socialync.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
